rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /completion-videos/{fileName} {
      // Ai đăng nhập đều có thể upload video (max 50MB, chỉ video)
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      // Ai cũng có thể xem video (kể cả khách hàng)
      allow read: if true;
    }
  }
}
