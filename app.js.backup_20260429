// Check trùng số HĐ trong cùng cơ sở (cả HV cơ bản + VĐV CLB)
async function checkDuplicateContract(contractNumber, branchId) {
    if (!contractNumber || !branchId) return null;
    // Check trong students
    const studentsSnap = await db.collection('students')
        .where('branchId', '==', branchId)
        .get();
    const dupStudent = studentsSnap.docs.find(doc => doc.data().contractNumber === contractNumber);
    if (dupStudent) {
        const d = dupStudent.data();
        return `Số hợp đồng "${contractNumber}" đã tồn tại!\n👤 HV: ${d.name || 'N/A'}\n📋 Loại: Học viên cơ bản\n\nVui lòng kiểm tra lại.`;
    }
    // Check trong athletes (CLB)
    const athletesSnap = await db.collection('athletes')
        .where('branchId', '==', branchId)
        .get();
    const dupAthlete = athletesSnap.docs.find(doc => doc.data().contractNumber === contractNumber);
    if (dupAthlete) {
        const d = dupAthlete.data();
        return `Số hợp đồng "${contractNumber}" đã tồn tại!\n👤 VĐV: ${d.name || 'N/A'}\n📋 Loại: CLB KID TL\n\nVui lòng kiểm tra lại.`;
    }
    return null; // Không trùng
}

